# ── Database ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vu

# ── Server ────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────
# Use a strong random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=vu-dev-jwt-secret-change-in-production

# ── AI Service ────────────────────────────────────────
# Must match the AI service's BACKEND_API_KEY
AI_SERVICE_API_KEY=vu-ai-dev-api-key
AI_SERVICE_URL=http://localhost:8000

# ── Frontend (CORS) ───────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Cloudinary (optional — video uploads) ─────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Mail (optional — email verification) ──────────────
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=